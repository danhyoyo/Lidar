{
  "dataset": "kitti",
  "num_classes": 4,
  "out_size_factor": 4,
  "train": {
    "epochs": 70,
    "batch_size": 4,
    "lr": 0.001,
    "weight_decay": 0.0001
  },
  "data": {
    "bev_encoding": {
      "name": "rich_mamba",
      "d_model": 16,
      "d_state": 16,
      "max_points_per_pillar": 20,
      "max_pillars": 32000,
      "out_channels": 8,
      "use_dual_pooling": true
    }
  },
  "model": {
    "backbone": "mobilepixornext",
    "backbone_out_dim": 16,
    "cls_encoding": "gaussian",
    "header_use_bn": true,
    "header_act": "silu",
    "header_use_iou": true,
    "bev_encoding": {
      "name": "rich_mamba",
      "d_model": 16,
      "d_state": 16,
      "max_points_per_pillar": 20,
      "max_pillars": 32000,
      "out_channels": 8,
      "use_dual_pooling": true
    },
    "geometry": {
      "x_min": 0.0,
      "x_max": 70.4,
      "x_res": 0.1,
      "y_min": -40.0,
      "y_max": 40.0,
      "y_res": 0.1,
      "z_min": -2.5,
      "z_max": 1.0,
      "z_res": 0.1
    }
  }
}
