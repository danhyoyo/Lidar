{
  "augmentation": {
    "p": 0.5,
    "rotation": {
      "limit_angle": 20,
      "p": 1,
      "use": true
    },
    "scaling": {
      "p": 1,
      "range": [
        0.95,
        1.05
      ],
      "use": true
    },
    "translation": {
      "p": 1,
      "scale": 0.4,
      "use": true
    }
  },
  "data": {
    "gaussian_overlap": 0.1,
    "kitti": {
      "geometry": {
        "x_max": 70.4,
        "x_min": 0,
        "x_res": 0.1,
        "y_max": 40,
        "y_min": -40,
        "y_res": 0.1,
        "z_max": 1,
        "z_min": -2.5,
        "z_res": 0.1
      },
      "location": "data/kitti/processed",
      "objects": {
        "Car": 0,
        "Cyclist": 2,
        "Pedestrian": 1
      }
    },
    "min_radius": 4,
    "num_classes": 3,
    "out_size_factor": 4,
    "bev_encoding": {
      "density_norm": 32,
      "intensity_scale": 1,
      "name": "rich8"
    }
  },
  "date": "reproducible",
  "device": "cuda",
  "loss": {
    "name": "baseline"
  },
  "model": {
    "backbone": "mobilepixor",
    "backbone_out_dim": 16,
    "cls_encoding": "gaussian",
    "box_encoding": "center3d",
    "gaussian_propagation": {
      "mode": "plain",
      "sigma_cells": 1.5,
      "radius_cells": 2,
      "strength": 1,
      "kernel_type": "uniform"
    }
  },
  "multi_gpu": false,
  "note": "visibility_gated_gaussian_pillar_ablation_uniform_control",
  "seed": 42,
  "train": {
    "accumulation_steps": 2,
    "data": "splits/kitti/train.txt",
    "epochs": 50,
    "learning_rate": 0.0003,
    "lr_decay_at": [
      30,
      40
    ],
    "momentum": 0.9,
    "physical_batch_size": 2,
    "precision": "bf16",
    "save_every": 10,
    "weight_decay": 0.0005
  },
  "val": {
    "data": "splits/kitti/gaussian_visibility/select.txt",
    "physical_batch_size": 2,
    "val_every": 1
  },
  "ver": 1
}
