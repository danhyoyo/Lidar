{
  "augmentation": {
    "p": 0.5,
    "rotation": {"limit_angle": 20, "p": 1, "use": true},
    "scaling": {"p": 1, "range": [0.95, 1.05], "use": true},
    "translation": {"p": 1, "scale": 0.4, "use": true}
  },
  "data": {
    "gaussian_overlap": 0.1,
    "kitti": {
      "geometry": {
        "x_max": 70.4, "x_min": 0, "x_res": 0.1,
        "y_max": 40, "y_min": -40, "y_res": 0.1,
        "z_max": 1, "z_min": -2.5, "z_res": 0.1
      },
      "location": "data/kitti/processed",
      "objects": {"Car": 0, "Cyclist": 2, "Pedestrian": 1}
    },
    "min_radius": 4,
    "num_classes": 3,
    "out_size_factor": 4,
    "bev_encoding": {"density_norm": 32, "intensity_scale": 1, "name": "rich8"}
  },
  "date": "reproducible",
  "device": "cuda",
  "loss": {"name": "baseline"},
  "model": {
    "backbone": "mobilepixor",
    "backbone_out_dim": 16,
    "header_use_bn": true,
    "header_act": "silu",
    "c4_attention": "litemla",
    "c5_attention": "c2psa",
    "cls_encoding": "gaussian",
    "scale_gated_fpn": true,
    "c2psa": {"attn_ratio": 0.5, "expansion": 0.5, "repeats": 1},
    "lsk": {"layer_scale_init": 0.01},
    "litemla": {
      "head_dim": 16, "scales": [5], "eps": 0.000001,
      "layer_scale_init": 0.01
    },
    "dat": {"num_heads": 4, "num_groups": 4, "stride": 4, "offset_kernel_size": 5, "offset_range_factor": 2.0, "layer_scale_init": 0.01},
    "bra": {"num_heads": 4, "n_win": 8, "topk": 4, "side_dwconv": 3, "layer_scale_init": 0.01},
    "c4_attention_route": "shared"
  },
  "multi_gpu": false,
  "note": "kitti_mobilepixor_c4_litemla_c5_c2psa_shared_aug_bf16",
  "seed": 42,
  "train": {
    "accumulation_steps": 2,
    "data": "splits/kitti/train.txt",
    "epochs": 100,
    "learning_rate": 0.0005,
    "lr_decay_at": [60, 85],
    "momentum": 0.9,
    "physical_batch_size": 16,
    "precision": "bf16",
    "save_every": 5,
    "weight_decay": 0.0001
  },
  "val": {"data": "splits/kitti/val.txt", "physical_batch_size": 16, "val_every": 1},
  "ver": 1
}
