{
  "ver": 1,
  "date": "reproducible",
  "device": "cuda",
  "seed": 42,
  "note": "Master Unified Configuration for 3D LiDAR Object Detection",
  "experiment": {
    "name": "default"
  },
  "data": {
    "num_classes": 3,
    "out_size_factor": 4,
    "gaussian_overlap": 0.1,
    "min_radius": 4,
    "regression_assignment": "nearest_center",
    "bev_encoding": {
      "name": "rich8",
      "density_norm": 32,
      "intensity_scale": 1
    },
    "kitti": {
      "location": "data/kitti/processed",
      "peak_mode": "per_class",
      "objects": {
        "Car": 0,
        "Pedestrian": 1,
        "Cyclist": 2
      },
      "geometry": {
        "x_min": 0,
        "x_max": 70.4,
        "x_res": 0.1,
        "y_min": -40,
        "y_max": 40,
        "y_res": 0.1,
        "z_min": -2.5,
        "z_max": 1,
        "z_res": 0.1
      }
    }
  },
  "model": {
    "backbone": "mobilepixornext",
    "backbone_out_dim": 16,
    "cls_encoding": "gaussian",
    "c4_attention": "litemla",
    "c4_attention_scales": [
      5
    ],
    "c4_attention_qk_norm": "none",
    "scale_gated_fpn": true,
    "expansion": 2.5,
    "header_use_bn": true,
    "header_act": "silu",
    "use_reparam": false,
    "header_use_iou": false
  },
  "loss": {
    "name": "baseline"
  },
  "augmentation": {
    "mode": "one_of",
    "p": 0.5,
    "rotation": {
      "use": true,
      "limit_angle": 20,
      "p": 1
    },
    "scaling": {
      "use": true,
      "range": [
        0.95,
        1.05
      ],
      "p": 1
    },
    "translation": {
      "use": true,
      "scale": 0.4,
      "scale_z": 0.4,
      "p": 1
    }
  },
  "train": {
    "data": "splits/kitti/train.txt",
    "epochs": 50,
    "warmup_epochs": 4,
    "learning_rate": 0.0007,
    "min_lr": 1e-06,
    "optimizer": "adamw",
    "weight_decay": 0.001,
    "grad_clip_norm": 10.0,
    "physical_batch_size": 16,
    "accumulation_steps": 1,
    "precision": "bf16",
    "num_workers": 6,
    "target_backend": "numba",
    "compile_model": false,
    "save_every": 5,
    "checkpoint_selection": {
      "primary": "ap",
      "ap_every": 1,
      "metric_mode": "auto"
    }
  },
  "val": {
    "data": "splits/kitti/val.txt",
    "physical_batch_size": 32,
    "val_every": 1
  },
  "evaluation": {
    "kitti_root": "data/kitti/raw",
    "score_threshold": 0.05,
    "nms_threshold": 0.1,
    "max_detections": 500
  }
}
