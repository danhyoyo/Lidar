\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Empirical multi-task loss trajectories over 50 training epochs on the KITTI benchmark for architectural configurations A1--A10 (Table~\ref {tab:components}). Subpanels depict: \textbf  {(a)} Total training loss, \textbf  {(b)} Total validation loss, \textbf  {(c)} Focal classification loss, \textbf  {(d)} Geometric OGA loss ($\ell _{\mathrm  {proj}} + \ell _{\mathrm  {corner}}$), \textbf  {(e)} IQA quality alignment loss, \textbf  {(f)} Subcell horizontal offset loss, \textbf  {(g)} Footprint bounding dimension loss, and \textbf  {(h)} Doubled-angle yaw orientation loss. Trajectories illustrate stable monotonic descent from initial magnitudes ($10^4$) to asymptotic convergence ($\sim 1.0$), with transient validation classification fluctuations at epochs 18--25 rapidly stabilized by T-SBUW adaptive weighting.}}{25}{figure.9}\protected@file@percent }
\newlabel{fig:loss_curves}{{9}{25}{Empirical multi-task loss trajectories over 50 training epochs on the KITTI benchmark for architectural configurations A1--A10 (Table~\ref {tab:components}). Subpanels depict: \textbf {(a)} Total training loss, \textbf {(b)} Total validation loss, \textbf {(c)} Focal classification loss, \textbf {(d)} Geometric OGA loss ($\ell _{\mathrm {proj}} + \ell _{\mathrm {corner}}$), \textbf {(e)} IQA quality alignment loss, \textbf {(f)} Subcell horizontal offset loss, \textbf {(g)} Footprint bounding dimension loss, and \textbf {(h)} Doubled-angle yaw orientation loss. Trajectories illustrate stable monotonic descent from initial magnitudes ($10^4$) to asymptotic convergence ($\sim 1.0$), with transient validation classification fluctuations at epochs 18--25 rapidly stabilized by T-SBUW adaptive weighting}{figure.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Geometric supervision (Baseline Smooth-L1 vs. OGA), localization quality prediction (with and without an IQA Head), and head-free Q-OGA on KITTI validation at Moderate difficulty ($R_{40}$). IQA models rank NMS candidates using $S_{\mathrm  {det}} = \sqrt  {P_{\mathrm  {cls}} \hat  {q}}$. Best values are in \textbf  {bold}, and second-best are \underline  {underlined}.}}{26}{table.9}\protected@file@percent }
\newlabel{tab:loss}{{9}{26}{Geometric supervision (Baseline Smooth-L1 vs. OGA), localization quality prediction (with and without an IQA Head), and head-free Q-OGA on KITTI validation at Moderate difficulty ($R_{40}$). IQA models rank NMS candidates using $S_{\mathrm {det}} = \sqrt {P_{\mathrm {cls}} \hat {q}}$. Best values are in \textbf {bold}, and second-best are \underline {underlined}}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Ablation of 3D spatial-energy attention (SimAM) integration topologies and placement strategies within the MobilePIXORNeXt backbone on the KITTI validation benchmark ($R_{40}$). Stage-level variants append a single attention adapter at stage downsampling boundaries ($C_2, C_3, C_4$), whereas the proposed Block-SimAM embeds parameter-free 3D energy attention inside all nine \texttt  {MobilePIXORNeXt-S} residual blocks before LayerScale scaling. Best values are in \textbf  {bold}, and second-best are \underline  {underlined}.}}{26}{table.10}\protected@file@percent }
\newlabel{tab:attention}{{10}{26}{Ablation of 3D spatial-energy attention (SimAM) integration topologies and placement strategies within the MobilePIXORNeXt backbone on the KITTI validation benchmark ($R_{40}$). Stage-level variants append a single attention adapter at stage downsampling boundaries ($C_2, C_3, C_4$), whereas the proposed Block-SimAM embeds parameter-free 3D energy attention inside all nine \texttt {MobilePIXORNeXt-S} residual blocks before LayerScale scaling. Best values are in \textbf {bold}, and second-best are \underline {underlined}}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Qualitative comparison of Bird's-Eye View (BEV) detections and predicted classification heatmaps between the baseline MobilePIXOR and MobilePIXORNeXt (Ours) across two representative driving scenes. \textbf  {Row A}: MobilePIXOR exhibits diffused, low-amplitude heatmap responses with noticeable background clutter, leading to missed detections (false negatives) on distant and sparse point clusters. \textbf  {Row B}: MobilePIXORNeXt produces sharp, concentrated focal peaks strictly centered on vehicle targets with suppressed background activations, successfully recovering distant objects and yielding tightly aligned oriented bounding footprints.}}{27}{figure.10}\protected@file@percent }
\newlabel{fig:comparison_heatmap}{{10}{27}{Qualitative comparison of Bird's-Eye View (BEV) detections and predicted classification heatmaps between the baseline MobilePIXOR and MobilePIXORNeXt (Ours) across two representative driving scenes. \textbf {Row A}: MobilePIXOR exhibits diffused, low-amplitude heatmap responses with noticeable background clutter, leading to missed detections (false negatives) on distant and sparse point clusters. \textbf {Row B}: MobilePIXORNeXt produces sharp, concentrated focal peaks strictly centered on vehicle targets with suppressed background activations, successfully recovering distant objects and yielding tightly aligned oriented bounding footprints}{figure.10}{}}
