\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Inference Latency and Real-Time Complexity}{18}{subsection.5.2}\protected@file@percent }
\newlabel{sec:latency_analysis}{{5.2}{18}{Inference Latency and Real-Time Complexity}{subsection.5.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Pipeline Latency vs. Model Forward Throughput.}{18}{section*.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Pareto trade-off efficiency of MobilePIXORNeXt against representative LiDAR detectors on the KITTI validation benchmark under the Moderate BEV protocol ($R_{40}$). \textbf  {(a)} Detection accuracy ($\text  {mAP}_{\mathrm  {M}}$, \%) versus parameter footprint (M) on a logarithmic scale, highlighting that MobilePIXORNeXt achieves $71.50\%$ Moderate mAP with only $0.754\,\text  {M}$ parameters, matching SECOND ($72.09\%$, $5.33\,\text  {M}$) and outperforming PointPillars ($70.13\%$, $4.84\,\text  {M}$) with $>84\%$ fewer parameters. \textbf  {(b)} Detection accuracy ($\text  {mAP}_{\mathrm  {M}}$, \%) versus end-to-end pipeline latency (ms) measured on an NVIDIA Tesla T4 GPU at batch size 1, demonstrating that MobilePIXORNeXt establishes the fastest complete perception pipeline ($60.96\,\text  {ms}$, $16.41\,\text  {FPS}$) among all evaluated real-time detectors.}}{19}{figure.7}\protected@file@percent }
\newlabel{fig:pareto_tradeoff}{{7}{19}{Pareto trade-off efficiency of MobilePIXORNeXt against representative LiDAR detectors on the KITTI validation benchmark under the Moderate BEV protocol ($R_{40}$). \textbf {(a)} Detection accuracy ($\text {mAP}_{\mathrm {M}}$, \%) versus parameter footprint (M) on a logarithmic scale, highlighting that MobilePIXORNeXt achieves $71.50\%$ Moderate mAP with only $0.754\,\text {M}$ parameters, matching SECOND ($72.09\%$, $5.33\,\text {M}$) and outperforming PointPillars ($70.13\%$, $4.84\,\text {M}$) with $>84\%$ fewer parameters. \textbf {(b)} Detection accuracy ($\text {mAP}_{\mathrm {M}}$, \%) versus end-to-end pipeline latency (ms) measured on an NVIDIA Tesla T4 GPU at batch size 1, demonstrating that MobilePIXORNeXt establishes the fastest complete perception pipeline ($60.96\,\text {ms}$, $16.41\,\text {FPS}$) among all evaluated real-time detectors}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Pipeline latency and throughput on KITTI validation (3,769 frames, including 3,759 timed frames after 10 warmup frames) on a unified NVIDIA Tesla T4 GPU platform. Batch size is 1, with FP32 precision. Forward latency covers network execution alone. End-to-End (E2E) latency includes raw LiDAR file I/O, statistical rasterization, Host-to-Device (H2D) transfer, network execution, coordinate decoding, and class-wise rotated NMS. Best values among single-stage models are in \textbf  {bold}, and second-best are \underline  {underlined}.}}{19}{table.5}\protected@file@percent }
\newlabel{tab:efficiency}{{5}{19}{Pipeline latency and throughput on KITTI validation (3,769 frames, including 3,759 timed frames after 10 warmup frames) on a unified NVIDIA Tesla T4 GPU platform. Batch size is 1, with FP32 precision. Forward latency covers network execution alone. End-to-End (E2E) latency includes raw LiDAR file I/O, statistical rasterization, Host-to-Device (H2D) transfer, network execution, coordinate decoding, and class-wise rotated NMS. Best values among single-stage models are in \textbf {bold}, and second-best are \underline {underlined}}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Precision--recall curves evaluated under the unified benchmark protocol on the KITTI validation split. Columns show Car ($\tau _{\mathrm  {IoU}}=0.70$), Pedestrian ($0.50$), and Cyclist ($0.50$); rows show Easy, Moderate, and Hard difficulties. MobilePIXORNeXt is red, MobilePIXOR gray, PointPillars blue, SECOND orange, PIXOR pink, PointRCNN purple, Part-A$^2$ green, and PV-RCNN teal. PIXOR supports Car only. AP $R_{40}$ is the discrete average of interpolated precision at the 40 recall positions specified in Section~\ref {sec:dataset_and_metrics}. Pedestrian Moderate AP is $60.78\%$, $56.01\%$, and $56.56\%$ for MobilePIXORNeXt, PointPillars, and SECOND, respectively; the corresponding Cyclist values are $66.81\%$, $66.34\%$, and $71.16\%$. All models are evaluated under identical test splits and evaluation criteria.}}{20}{figure.8}\protected@file@percent }
\newlabel{fig:pr_curves}{{8}{20}{Precision--recall curves evaluated under the unified benchmark protocol on the KITTI validation split. Columns show Car ($\tau _{\mathrm {IoU}}=0.70$), Pedestrian ($0.50$), and Cyclist ($0.50$); rows show Easy, Moderate, and Hard difficulties. MobilePIXORNeXt is red, MobilePIXOR gray, PointPillars blue, SECOND orange, PIXOR pink, PointRCNN purple, Part-A$^2$ green, and PV-RCNN teal. PIXOR supports Car only. AP $R_{40}$ is the discrete average of interpolated precision at the 40 recall positions specified in Section~\ref {sec:dataset_and_metrics}. Pedestrian Moderate AP is $60.78\%$, $56.01\%$, and $56.56\%$ for MobilePIXORNeXt, PointPillars, and SECOND, respectively; the corresponding Cyclist values are $66.81\%$, $66.34\%$, and $71.16\%$. All models are evaluated under identical test splits and evaluation criteria}{figure.8}{}}
