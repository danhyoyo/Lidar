\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Prediction-head geometry, orientation, and quality-aware scoring. \textbf  {(a)} Metric subcell offsets $(\hat  {o}_x, \hat  {o}_y)$ from grid anchor center $P$ to object center $C$. \textbf  {(b)} Log-dimension targets $(t_w, t_l) = (\log w, \log l)$ decoded by exponentiation. \textbf  {(c)} Doubled-angle yaw representation $(c_2, s_2) = (\cos 2\theta , \sin 2\theta )$ on the unit circle, resolving $180^\circ $ heading ambiguity through $\pi $-rotational symmetry of BEV footprints. \textbf  {(d)} Joint quality scoring combines overlap prediction $\hat  {q} \in [0, 1]$ and classification probability $p_{\mathrm  {cls}}$ as $s_{\mathrm  {det}} = (p_{\mathrm  {cls}})^{1-\alpha } \hat  {q}^\alpha $ ($\alpha = 0.5$). This score prioritizes well-aligned boxes during peak filtering and rotated NMS.}}{12}{figure.6}\protected@file@percent }
\newlabel{fig:geometry_output}{{6}{12}{Prediction-head geometry, orientation, and quality-aware scoring. \textbf {(a)} Metric subcell offsets $(\hat {o}_x, \hat {o}_y)$ from grid anchor center $P$ to object center $C$. \textbf {(b)} Log-dimension targets $(t_w, t_l) = (\log w, \log l)$ decoded by exponentiation. \textbf {(c)} Doubled-angle yaw representation $(c_2, s_2) = (\cos 2\theta , \sin 2\theta )$ on the unit circle, resolving $180^\circ $ heading ambiguity through $\pi $-rotational symmetry of BEV footprints. \textbf {(d)} Joint quality scoring combines overlap prediction $\hat {q} \in [0, 1]$ and classification probability $p_{\mathrm {cls}}$ as $s_{\mathrm {det}} = (p_{\mathrm {cls}})^{1-\alpha } \hat {q}^\alpha $ ($\alpha = 0.5$). This score prioritizes well-aligned boxes during peak filtering and rotated NMS}{figure.6}{}}
