\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Quantitative comparison of Bird's-Eye View (BEV) object detection performance on the KITTI validation benchmark. Average Precision (AP, \%) is evaluated under the 40-point interpolation protocol ($R_{40}$) at Moderate difficulty ($\text  {IoU} \ge 0.70$ for Car; $\text  {IoU} \ge 0.50$ for Pedestrian and Cyclist). All experiments are conducted using the unified evaluation implementation and benchmarked on the same NVIDIA Tesla T4 GPU platform. The top partition benchmarks single-stage real-time and edge-oriented LiDAR detectors (spanning ultra-compact BEV representations to pillar and 3D sparse voxel networks); the bottom partition provides external reference with heavyweight two-stage 3D anchor-based detectors. For single-stage methods, the best results are highlighted in \textbf  {bold}, and the second-best results are \underline  {underlined}.}}{18}{table.3}\protected@file@percent }
\newlabel{tab:comparison}{{3}{18}{Quantitative comparison of Bird's-Eye View (BEV) object detection performance on the KITTI validation benchmark. Average Precision (AP, \%) is evaluated under the 40-point interpolation protocol ($R_{40}$) at Moderate difficulty ($\text {IoU} \ge 0.70$ for Car; $\text {IoU} \ge 0.50$ for Pedestrian and Cyclist). All experiments are conducted using the unified evaluation implementation and benchmarked on the same NVIDIA Tesla T4 GPU platform. The top partition benchmarks single-stage real-time and edge-oriented LiDAR detectors (spanning ultra-compact BEV representations to pillar and 3D sparse voxel networks); the bottom partition provides external reference with heavyweight two-stage 3D anchor-based detectors. For single-stage methods, the best results are highlighted in \textbf {bold}, and the second-best results are \underline {underlined}}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Multi-seed statistical robustness and variance comparison between baseline MobilePIXOR and the proposed MobilePIXORNeXt on the KITTI validation benchmark across three random seeds ($42, 43, 44$) under a 100-epoch training schedule. Detections are evaluated under the unified BEV evaluation protocol with 40-point interpolation ($R_{40}$). Performance is reported across individual seeds alongside the sample mean and standard deviation ($\text  {Mean} \pm \text  {Std}$, \%). The best mean and lowest variance values are highlighted in \textbf  {bold}.}}{18}{table.4}\protected@file@percent }
