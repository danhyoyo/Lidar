\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces MobilePIXORNeXt accuracy, parameter count, and latency on KITTI validation using Moderate BEV AP $R_{40}$. \textbf  {(a)} Accuracy ($\text  {mAP}_{\mathrm  {M}}$, \%) versus parameter count (M, logarithmic scale). MobilePIXORNeXt (red star) achieves $71.46\%$ mAP with $0.754\,\text  {M}$ parameters, trailing SECOND ($72.09\%$, $5.33\,\text  {M}$) by only $0.63\,\text  {pp}$ and exceeding PointPillars ($70.13\%$, $4.84\,\text  {M}$) by $+1.33\,\text  {pp}$ with $>84\%$ fewer parameters. \textbf  {(b)} Accuracy ($\text  {mAP}_{\mathrm  {M}}$, \%) versus end-to-end latency (ms) at batch size 1 on NVIDIA Tesla T4. MobilePIXORNeXt has the lowest complete pipeline latency ($60.96\,\text  {ms}$, $16.41\,\text  {FPS}$) among the evaluated real-time detectors.}}{17}{figure.7}\protected@file@percent }
\newlabel{fig:pareto_tradeoff}{{7}{17}{MobilePIXORNeXt accuracy, parameter count, and latency on KITTI validation using Moderate BEV AP $R_{40}$. \textbf {(a)} Accuracy ($\text {mAP}_{\mathrm {M}}$, \%) versus parameter count (M, logarithmic scale). MobilePIXORNeXt (red star) achieves $71.46\%$ mAP with $0.754\,\text {M}$ parameters, trailing SECOND ($72.09\%$, $5.33\,\text {M}$) by only $0.63\,\text {pp}$ and exceeding PointPillars ($70.13\%$, $4.84\,\text {M}$) by $+1.33\,\text {pp}$ with $>84\%$ fewer parameters. \textbf {(b)} Accuracy ($\text {mAP}_{\mathrm {M}}$, \%) versus end-to-end latency (ms) at batch size 1 on NVIDIA Tesla T4. MobilePIXORNeXt has the lowest complete pipeline latency ($60.96\,\text {ms}$, $16.41\,\text {FPS}$) among the evaluated real-time detectors}{figure.7}{}}
