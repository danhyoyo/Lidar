\newlabel{eq:spatial_moments}{{12}{9}{Design and Placement}{equation.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The \texttt  {MobilePIXORNeXt-S} residual block and parameter-free Block-SimAM attention. \textbf  {Top}: Residual path from input $\mathbf  {Z}$ to output $\mathbf  {Z}'$. It applies a $7 \times 7$ depthwise convolution, inverted bottleneck expansion with ratio $e = 2.5$, and SiLU activation, followed by pointwise projection. Parameter-free 3D spatial-energy attention $\mathcal  {S}(\mathbf  {R})$ precedes LayerScale scaling $\boldsymbol  {\gamma }_{\mathrm  {blk}}$ (initialized to $10^{-5}$) and the identity shortcut. \textbf  {Bottom}: SimAM computes channel-wise spatial moments ($\mu _c, \nu _c$) in FP32 precision and inverse-energy importance $s_t = (t - \mu _c)^2 / (4(\nu _c + \lambda _{\mathrm  {sim}})) + 0.5$. Sigmoid scaling produces the 3D modulation tensor $\mathbf  {A} \in [0, 1]^{B \times C \times H \times W}$ without learned parameters.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:next_s_block}{{4}{10}{The \texttt {MobilePIXORNeXt-S} residual block and parameter-free Block-SimAM attention. \textbf {Top}: Residual path from input $\mathbf {Z}$ to output $\mathbf {Z}'$. It applies a $7 \times 7$ depthwise convolution, inverted bottleneck expansion with ratio $e = 2.5$, and SiLU activation, followed by pointwise projection. Parameter-free 3D spatial-energy attention $\mathcal {S}(\mathbf {R})$ precedes LayerScale scaling $\boldsymbol {\gamma }_{\mathrm {blk}}$ (initialized to $10^{-5}$) and the identity shortcut. \textbf {Bottom}: SimAM computes channel-wise spatial moments ($\mu _c, \nu _c$) in FP32 precision and inverse-energy importance $s_t = (t - \mu _c)^2 / (4(\nu _c + \lambda _{\mathrm {sim}})) + 0.5$. Sigmoid scaling produces the 3D modulation tensor $\mathbf {A} \in [0, 1]^{B \times C \times H \times W}$ without learned parameters}{figure.4}{}}
\newlabel{eq:simam_energy}{{13}{10}{Design and Placement}{equation.13}{}}
\newlabel{eq:simam_modulation}{{14}{10}{Design and Placement}{equation.14}{}}
