\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Ablation of 3D spatial-energy attention (SimAM) integration topologies and placement strategies within the MobilePIXORNeXt backbone on the KITTI validation benchmark ($R_{40}$). Stage-level variants append a single attention adapter at stage downsampling boundaries ($C_2, C_3, C_4$), whereas the proposed Block-SimAM embeds parameter-free 3D energy attention inside all nine \texttt  {MobilePIXORNeXt-S} residual blocks before LayerScale scaling. Best values are in \textbf  {bold}, and second-best are \underline  {underlined}.}}{22}{table.9}\protected@file@percent }
\newlabel{tab:attention}{{9}{22}{Ablation of 3D spatial-energy attention (SimAM) integration topologies and placement strategies within the MobilePIXORNeXt backbone on the KITTI validation benchmark ($R_{40}$). Stage-level variants append a single attention adapter at stage downsampling boundaries ($C_2, C_3, C_4$), whereas the proposed Block-SimAM embeds parameter-free 3D energy attention inside all nine \texttt {MobilePIXORNeXt-S} residual blocks before LayerScale scaling. Best values are in \textbf {bold}, and second-best are \underline {underlined}}{table.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Multi-Task Optimization Dynamics and Convergence.}{22}{section*.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Training and validation loss trajectories over 50 epochs on KITTI for configurations A1 through A10 (Table~\ref {tab:components}). The top panels show total training loss (left) and validation loss (right) on logarithmic scales. Six task panels show Classification Focal Loss, Oriented Geometry Loss (OGA), IoU Quality Loss (IQA), Subcell Centroid Offset Loss, Footprint Size Loss, and Doubled-Angle Yaw Loss. The legend traces baseline A1 (Binary35), Strata-BEV (A2--A3), Decoupled GroupedHeader (A4--A5), PC-GTA (A6), SG-FPN (A7--A8), OGA and IQA (A9), and final configuration A10 (Block-SimAM). The trajectories demonstrate overall convergence across multi-task objectives under T-SBUW balancing, despite visible transient validation spikes in classification (around epochs 18--25, briefly reaching $\sim 10^2$ before dampening) and minor fluctuations across early regression phases. In late training, configuration A10 achieves competitive validation losses across regression heads alongside A9.}}{23}{figure.9}\protected@file@percent }
\newlabel{fig:loss_curves}{{9}{23}{Training and validation loss trajectories over 50 epochs on KITTI for configurations A1 through A10 (Table~\ref {tab:components}). The top panels show total training loss (left) and validation loss (right) on logarithmic scales. Six task panels show Classification Focal Loss, Oriented Geometry Loss (OGA), IoU Quality Loss (IQA), Subcell Centroid Offset Loss, Footprint Size Loss, and Doubled-Angle Yaw Loss. The legend traces baseline A1 (Binary35), Strata-BEV (A2--A3), Decoupled GroupedHeader (A4--A5), PC-GTA (A6), SG-FPN (A7--A8), OGA and IQA (A9), and final configuration A10 (Block-SimAM). The trajectories demonstrate overall convergence across multi-task objectives under T-SBUW balancing, despite visible transient validation spikes in classification (around epochs 18--25, briefly reaching $\sim 10^2$ before dampening) and minor fluctuations across early regression phases. In late training, configuration A10 achieves competitive validation losses across regression heads alongside A9}{figure.9}{}}
