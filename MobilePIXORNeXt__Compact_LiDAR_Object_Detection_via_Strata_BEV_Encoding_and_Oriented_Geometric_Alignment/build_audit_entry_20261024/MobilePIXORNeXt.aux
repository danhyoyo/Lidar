\@writefile{toc}{\contentsline {paragraph}{Motivation.}{10}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Scale-Gated Feature Pyramid Network (SG-FPN) fusion at stride $r \in \{8, 4\}$. Bilinear interpolation upsamples top-down features. Depthwise refinement at stride 8 and projection convolution at stride 4 produce representations $\mathbf  {U}_4$ and $\mathbf  {U}_3$ without deconvolution checkerboard artifacts. Lateral high-resolution features $\mathbf  {L}_r$ are weighted by a zero-initialized depthwise gate $\mathbf  {G}_r = 2\sigma (\operatorname  {DWConv}_{3\times 3}(\mathbf  {L}_r + \mathbf  {U}_r))$ before element-wise summation $\mathbf  {P}_r = \mathbf  {U}_r + \mathbf  {G}_r \odot \mathbf  {L}_r$ to retain boundary detail and suppress background responses.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:scale_gated_fusion}{{5}{11}{Scale-Gated Feature Pyramid Network (SG-FPN) fusion at stride $r \in \{8, 4\}$. Bilinear interpolation upsamples top-down features. Depthwise refinement at stride 8 and projection convolution at stride 4 produce representations $\mathbf {U}_4$ and $\mathbf {U}_3$ without deconvolution checkerboard artifacts. Lateral high-resolution features $\mathbf {L}_r$ are weighted by a zero-initialized depthwise gate $\mathbf {G}_r = 2\sigma (\operatorname {DWConv}_{3\times 3}(\mathbf {L}_r + \mathbf {U}_r))$ before element-wise summation $\mathbf {P}_r = \mathbf {U}_r + \mathbf {G}_r \odot \mathbf {L}_r$ to retain boundary detail and suppress background responses}{figure.5}{}}
